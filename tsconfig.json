{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": { "@hearth/elements": ["src/elements.ts"] }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "site/**/*.ts",
    "site/**/*.tsx",
    "site/**/*.vue",
    "*.ts"
  ]
}
