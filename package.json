{
  "name": "@samishal1998/hearth-ui",
  "version": "0.2.0",
  "description": "Themeable Vue components and web components for self-hosted dashboards, public pages, and authentication.",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "llms.txt",
    "docs/components"
  ],
  "sideEffects": [
    "**/*.css",
    "**/auto.js"
  ],
  "main": "./dist/vue/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./elements": {
      "types": "./dist/types/elements.d.ts",
      "import": "./dist/elements/index.js"
    },
    "./elements/auto": "./dist/elements/auto.js",
    "./styles.css": "./dist/vue/hearth-ui.css",
    "./themes.css": "./dist/themes.css"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "npm run docs:check && vue-tsc --noEmit",
    "build": "npm run check && node scripts/build.mjs",
    "build:site": "npm run docs:check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/theme.test.mjs && playwright test",
    "test:package": "node tests/package-smoke.mjs",
    "docs:generate": "node scripts/agent-docs.mjs",
    "docs:check": "node scripts/agent-docs.mjs --check && node --test tests/agent-docs.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samishal1998/hearth-ui.git"
  },
  "homepage": "https://samishal1998.github.io/hearth-ui/",
  "engines": {
    "node": ">=22.12.0"
  }
}
